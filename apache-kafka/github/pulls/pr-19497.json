{"pull": {"id": "number:19497", "number": 19497, "title": "KAFKA-19160;KAFKA-19164; Improve performance of fetching stable offsets", "state": "closed", "draft": false, "created_at": "2025-04-16T18:48:15Z", "closed_at": "2025-05-12T07:32:18Z", "merged_at": "2025-05-12T07:32:18Z", "user": {"login": "squah-confluent", "id": 163298686, "node_id": "U_kgDOCbu9fg", "avatar_url": "https://avatars.githubusercontent.com/u/163298686?v=4", "gravatar_id": "", "url": "https://api.github.com/users/squah-confluent", "html_url": "https://github.com/squah-confluent", "followers_url": "https://api.github.com/users/squah-confluent/followers", "following_url": "https://api.github.com/users/squah-confluent/following{/other_user}", "gists_url": "https://api.github.com/users/squah-confluent/gists{/gist_id}", "starred_url": "https://api.github.com/users/squah-confluent/starred{/owner}{/repo}", "subscriptions_url": "https://api.github.com/users/squah-confluent/subscriptions", "organizations_url": "https://api.github.com/users/squah-confluent/orgs", "repos_url": "https://api.github.com/users/squah-confluent/repos", "events_url": "https://api.github.com/users/squah-confluent/events{/privacy}", "received_events_url": "https://api.github.com/users/squah-confluent/received_events", "type": "User", "user_view_type": "public", "site_admin": false}, "body": "When fetching stable offsets in the group coordinator, we iterate over\nall requested partitions. For each partition, we iterate over the\ngroup's ongoing transactions to check if there is a pending\ntransactional offset commit for that partition.\n\nThis can get slow when there are a large number of partitions and a\nlarge number of pending transactions. Instead, maintain a list of\npending transactions per partition to speed up lookups.\n\nReviewers: Shaan, Dongnuo Lyu <dlyu@confluent.io>, Chia-Ping Tsai\n <chia7712@gmail.com>, David Jacot <djacot@confluent.io>\n", "labels": [{"id": 970614414, "node_id": "MDU6TGFiZWw5NzA2MTQ0MTQ=", "url": "https://api.github.com/repos/apache/kafka/labels/performance", "name": "performance", "color": "c2e0c6", "default": false, "description": "", "archived_at": null, "archived_by": null}, {"id": 4771354362, "node_id": "LA_kwDOACG9q88AAAABHGUW-g", "url": "https://api.github.com/repos/apache/kafka/labels/KIP-848", "name": "KIP-848", "color": "0E87F1", "default": false, "description": "The Next Generation of the Consumer Rebalance Protocol", "archived_at": null, "archived_by": null}, {"id": 7522931565, "node_id": "LA_kwDOACG9q88AAAABwGbTbQ", "url": "https://api.github.com/repos/apache/kafka/labels/ci-approved", "name": "ci-approved", "color": "ffffff", "default": false, "description": "", "archived_at": null, "archived_by": null}], "html_url": "https://github.com/apache/kafka/pull/19497"}, "reviews": [], "review_comments": [], "issue_comments": [], "commits": [], "files": [], "timeline": [], "_partial": "search", "_source": "extra-data/github-search/author_squah-confluent_is_pr.json"}