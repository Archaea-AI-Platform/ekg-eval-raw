{"pull": {"id": "number:20267", "number": 20267, "title": "KAFKA-19564: Close Consumer in ConsumerPerformance only after metrics displayed", "state": "closed", "draft": false, "created_at": "2025-07-30T15:39:25Z", "closed_at": "2025-09-03T08:25:22Z", "merged_at": "2025-09-03T08:25:22Z", "user": {"login": "kirktrue", "id": 92057, "node_id": "MDQ6VXNlcjkyMDU3", "avatar_url": "https://avatars.githubusercontent.com/u/92057?v=4", "gravatar_id": "", "url": "https://api.github.com/users/kirktrue", "html_url": "https://github.com/kirktrue", "followers_url": "https://api.github.com/users/kirktrue/followers", "following_url": "https://api.github.com/users/kirktrue/following{/other_user}", "gists_url": "https://api.github.com/users/kirktrue/gists{/gist_id}", "starred_url": "https://api.github.com/users/kirktrue/starred{/owner}{/repo}", "subscriptions_url": "https://api.github.com/users/kirktrue/subscriptions", "organizations_url": "https://api.github.com/users/kirktrue/orgs", "repos_url": "https://api.github.com/users/kirktrue/repos", "events_url": "https://api.github.com/users/kirktrue/events{/privacy}", "received_events_url": "https://api.github.com/users/kirktrue/received_events", "type": "User", "user_view_type": "public", "site_admin": false}, "body": "Ensure that metrics are retrieved and displayed (when requested) before\n`Consumer.close()` is called. This is important because metrics are\ntechnically supposed to be removed on `Consumer.close()`, which means\nretrieving them _after_ `close()` would yield an empty map.\n\nReviewers: Andrew Schofield <aschofield@confluent.io>\n", "labels": [{"id": 851034845, "node_id": "MDU6TGFiZWw4NTEwMzQ4NDU=", "url": "https://api.github.com/repos/apache/kafka/labels/tools", "name": "tools", "color": "fbca04", "default": false, "description": "", "archived_at": null, "archived_by": null}, {"id": 7522931565, "node_id": "LA_kwDOACG9q88AAAABwGbTbQ", "url": "https://api.github.com/repos/apache/kafka/labels/ci-approved", "name": "ci-approved