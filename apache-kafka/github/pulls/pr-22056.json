{"pull": {"id": "number:22056", "number": 22056, "title": "KAFKA-20450 : Fix : Allowlist based SafeObjectInputStream", "state": "closed", "draft": false, "created_at": "2026-04-14T14:30:32Z", "closed_at": "2026-04-28T06:03:00Z", "merged_at": "2026-04-28T06:03:00Z", "user": {"login": "subbudvk", "id": 115633743, "node_id": "U_kgDOBuRuTw", "avatar_url": "https://avatars.githubusercontent.com/u/115633743?v=4", "gravatar_id": "", "url": "https://api.github.com/users/subbudvk", "html_url": "https://github.com/subbudvk", "followers_url": "https://api.github.com/users/subbudvk/followers", "following_url": "https://api.github.com/users/subbudvk/following{/other_user}", "gists_url": "https://api.github.com/users/subbudvk/gists{/gist_id}", "starred_url": "https://api.github.com/users/subbudvk/starred{/owner}{/repo}", "subscriptions_url": "https://api.github.com/users/subbudvk/subscriptions", "organizations_url": "https://api.github.com/users/subbudvk/orgs", "repos_url": "https://api.github.com/users/subbudvk/repos", "events_url": "https://api.github.com/users/subbudvk/events{/privacy}", "received_events_url": "https://api.github.com/users/subbudvk/received_events", "type": "User", "user_view_type": "public", "site_admin": false}, "body": "The current **SafeObjectInputStream** uses a denylist based approach -\nhaving a fixed denylist to be validated against for deserialization.\nThis is a bad security practise and has also been advised so in the\noriginal PR.\n\nMaking this as a allowlist instead and allowing safe BASE_TYPES which\nare required by current caller\n(_org.apache.kafka.connect.storage.FileOffsetBackingStore_)\n\nAlso providing a `SafeObjectInputStream(InputStream in, Set<String>\nallowedClasses)` so if any consumer require any specific allowedClasses\nthey can pass in here.\n\nReviewers: Mickael Maison <mickael.maison@gmail.com>, Chia-Ping Tsai <chia7712@gmail.com>, Ken Huang <s7133700@gmail.com>\n", "labels": [{"id": 851037639, "node_id": "MDU6TGFiZWw4NTEwMzc2Mzk=", "url": "https://api.github.com/repos/apache/kafka/labels/connect", "name": "connect", "color": "0052cc", "default": false, "description": "", "archived_at": null, "archived_by": null}, {"id": 7522931565, "node_id": "LA_kwDOACG9q88AAAABwGbTbQ", "url": "https://api.github.com/repos/apache/kafka/labels/ci-approved", "name": "ci-approved", "color": "ffffff", "default": false, "description": "", "archived_at": null, "archived_by": null}, {"id": 7559660738, "node_id": "LA_kwDOACG9q88AAAABwpdEwg", "url": "https://api.github.com/repos/apache/kafka/labels/small", "name": "small", "color": "FEF2C0", "default": false, "description": "Small PRs", "archived_at": null, "archived_by": null}], "html_url": "https://github.com/apache/kafka/pull/22056"}, "reviews": [], "review_comments": [], "issue_comments": [], "commits": [], "files": [], "timeline": [], "_partial": "search", "_source": "extra-data/github-search/Cherry-pick_is_pr.json"}