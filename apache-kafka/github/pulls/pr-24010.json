  {
   "sha": "b33c57898f2cd5eae300eea24ed70417f8152ce0",
   "filename": "clients/src/test/java/org/apache/kafka/common/security/ssl/SslPrincipalMapperTest.java",
   "status": "modified",
   "additions": 30,
   "deletions": 0,
   "changes": 30,
   "blob_url": "https://github.com/apache/kafka/blob/f191443bee5511ca3503dbe9924184c04a41369e/clients%2Fsrc%2Ftest%2Fjava%2Forg%2Fapache%2Fkafka%2Fcommon%2Fsecurity%2Fssl%2FSslPrincipalMapperTest.java",
   "raw_url": "https://github.com/apache/kafka/raw/f191443bee5511ca3503dbe9924184c04a41369e/clients%2Fsrc%2Ftest%2Fjava%2Forg%2Fapache%2Fkafka%2Fcommon%2Fsecurity%2Fssl%2FSslPrincipalMapperTest.java",
   "contents_url": "https://api.github.com/repos/apache/kafka/contents/clients%2Fsrc%2Ftest%2Fjava%2Forg%2Fapache%2Fkafka%2Fcommon%2Fsecurity%2Fssl%2FSslPrincipalMapperTest.java?ref=f191443bee5511ca3503dbe9924184c04a41369e",
   "patch": "@@ -121,4 +121,34 @@ public void testCommaWithWhitespace() throws Exception {\n         SslPrincipalMapper mapper = SslPrincipalMapper.fromRules(rules);\n         assertEquals(\"Tkac\\\\, Adam\", mapper.getName(\"CN=Tkac\\\\, Adam,OU=ITZ,DC=geodis,DC=cz\"));\n     }\n+\n+    @Test\n+    public void testNameDerivedFromFullMatchWithAlternation() throws Exception {\n+        SslPrincipalMapper mapper = SslPrincipalMapper.fromRules(\"RULE:CN=([^,]+),O=corp|CN=([^,]+),O=corp,C=US/$2/, DEFAULT\");\n+        assertEquals(\"bob\", mapper.getName(\"CN=bob,O=corp,C=US\"));\n+    }\n+\n+    @Test\n+    public void testNameDerivedFromFullMatchWithUnanchoredPattern() throws Exception {\n+        SslPrincipalMapper mapper = SslPrincipalMapper.fromRules(\"RULE:CN=(.*?),OU=(.*?)/$1/, DEFAULT\");\n+        assertEquals(\"bob\", mapper.getName(\"CN=bob,OU=eng\"));\n+    }\n+\n+    @Test\n+    public void testReplacementAppliedOnce() throws Exception {\n+        SslPrincipalMapper mapper = SslPrincipalMapper.fromRules(\"RULE:(.*)/$1@EXAMPLE.COM/, DEFAULT\");\n+        assertEquals(\"CN=bob@EXAMPLE.COM\", mapper.getName(\"CN=bob\"));\n+    }\n+\n+    @Test\n+    public void testEmptyNameFallsThroughToNextRule() throws Exception {\n+        SslPrincipalMapper mapper = SslPrincipalMapper.fromRules(\"RULE:CN=([^,]+),O=corp|CN=([^,]+),O=corp,C=US/$1/, DEFAULT\");\n+        assertEquals(\"CN=bob,O=corp,C=US\", mapper.getName(\"CN=bob,O=corp,C=US\"));\n+    }\n+\n+    @Test\n+    public void testEmptyNameWithNoOtherRuleIsRejected() {\n+        SslPrincipalMapper mapper = SslPrincipalMapper.fromRules(\"RULE:^CN=(.*)$/$1/\");\n+        assertThrows(SslPrincipalMapper.NoMatchingRule.class, () -> mapper.getName(\"CN=\"));\n+    }\n }"
  }
