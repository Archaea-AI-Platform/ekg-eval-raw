{"pull": {"id": "number:23005", "number": 23005, "title": "KAFKA-20874: Close SslFactory in JaasOptionsUtils.createSSLSocketFactory()", "state": "closed", "draft": false, "created_at": "2026-07-31T16:10:26Z", "closed_at": "2026-08-06T02:28:10Z", "merged_at": "2026-08-06T02:28:10Z", "user": {"login": "fvaleri", "id": 11456498, "node_id": "MDQ6VXNlcjExNDU2NDk4", "avatar_url": "https://avatars.githubusercontent.com/u/11456498?v=4", "gravatar_id": "", "url": "https://api.github.com/users/fvaleri", "html_url": "https://github.com/fvaleri", "followers_url": "https://api.github.com/users/fvaleri/followers", "following_url": "https://api.github.com/users/fvaleri/following{/other_user}", "gists_url": "https://api.github.com/users/fvaleri/gists{/gist_id}", "starred_url": "https://api.github.com/users/fvaleri/starred{/owner}{/repo}", "subscriptions_url": "https://api.github.com/users/fvaleri/subscriptions", "organizations_url": "https://api.github.com/users/fvaleri/orgs", "repos_url": "https://api.github.com/users/fvaleri/repos", "events_url": "https://api.github.com/users/fvaleri/events{/privacy}", "received_events_url": "https://api.github.com/users/fvaleri/received_events", "type": "User", "user_view_type": "public", "site_admin": false}, "body": "The SslFactory created in createSSLSocketFactory() was never closed,\nleaking the underlying DefaultSslEngineFactory. Wrap in try/finally to\nclose it after extracting the SSLSocketFactory. This is safe because\nDefaultSslEngineFactory.close() only nulls its sslContext field without\ninvalidating the SSLContext held by the returned SSLSocketFactory.\n\nAdded a test to exercise createSSLSocketFactory() directly.\n\nReviewers: Luke Chen <showuon@gmail.com>, Ken Huang <s7133700@gmail.com>\n", "labels": [{"id": 7491388177, "node_id": "LA_kwDOACG9q88AAAABvoWDEQ", "url": "https://api.github.com/repos/apache/kafka/labels/clients", "name": "clients", "color": "ededed", "default": false, "description": null, "archived_at": null, "archived_by": null}, {"id": 7559660738, "node_id": "LA_kwDOACG9q88AAAABwpdEwg", "url": "https://api.github.com/repos/apache/kafka/labels/small", "name": "small", "color": "FEF2C0", "default": false, "description": "Small PRs", "archived_at": null, "archived_by": null}], "html_url": "https://github.com/apache/kafka/pull/23005"}, "reviews": [], "review_comments": [], "issue_comments": [], "commits": [], "files": [], "timeline": [], "_partial": "search", "_source": "extra-data/github-search/Cherry-pick_is_pr.json"}