   "blob_url": "https://github.com/apache/kafka/blob/db5c52a92362c851557fd8fa59919511738816c9/streams%2Fsrc%2Ftest%2Fjava%2Forg%2Fapache%2Fkafka%2Fstreams%2Fstate%2Finternals%2FPositionSerdeTest.java",
   "raw_url": "https://github.com/apache/kafka/raw/db5c52a92362c851557fd8fa59919511738816c9/streams%2Fsrc%2Ftest%2Fjava%2Forg%2Fapache%2Fkafka%2Fstreams%2Fstate%2Finternals%2FPositionSerdeTest.java",
   "contents_url": "https://api.github.com/repos/apache/kafka/contents/streams%2Fsrc%2Ftest%2Fjava%2Forg%2Fapache%2Fkafka%2Fstreams%2Fstate%2Finternals%2FPositionSerdeTest.java?ref=db5c52a92362c851557fd8fa59919511738816c9",
   "patch": "@@ -0,0 +1,97 @@\n+/*\n+ * Licensed to the Apache Software Foundation (ASF) under one or more\n+ * contributor license agreements. See the NOTICE file distributed with\n+ * this work for additional information regarding copyright ownership.\n+ * The ASF licenses this file to You under the Apache License, Version 2.0\n+ * (the \"License\"); you may not use this file except in compliance with\n+ * the License. You may obtain a copy of the License at\n+ *\n+ *    http://www.apache.org/licenses/LICENSE-2.0\n+ *\n+ * Unless required by applicable law or agreed to in writing, software\n+ * distributed under the License is distributed on an \"AS IS\" BASIS,\n+ * WITHOUT WARRANTIES OR CONDITIONS OF ANY KIND, either express or implied.\n+ * See the License for the specific language governing permissions and\n+ * limitations under the License.\n+ */\n+package org.apache.kafka.streams.state.internals;\n+\n+import org.apache.kafka.streams.query.Position;\n+\n+import org.junit.jupiter.api.Test;\n+\n+import java.nio.ByteBuffer;\n+\n+import static org.junit.jupiter.api.Assertions.assertEquals;\n+import static org.junit.jupiter.api.Assertions.assertThrows;\n+\n+public class PositionSerdeTest {\n+\n+    @Test\n+    public void shouldRoundTripPosition() {\n+        final Position position = Position.emptyPosition()\n+            .withComponent(\"topic1\", 0, 1L)\n+            .withComponent(\"topic1\", 1, 5L)\n+            .withComponent(\"topic2\", 3, 100L);\n+\n+        assertEquals(position, PositionSerde.deserialize(PositionSerde.serialize(position)));\n+    }\n+\n+    @Test\n+    public void shouldRoundTripEmptyPosition() {\n+        final Position position = Position.emptyPosition();\n+\n+        assertEquals(position, PositionSerde.deserialize(PositionSerde.serialize(position)));\n+    }\n+\n+    @Test\n+    public void shouldRejectTopicCountLargerThanRemainingBuffer() {\n+        final ByteBuffer buffer = ByteBuffer.allocate(1 + 4 + 4 + 1 + 4);\n+        buffer.put((byte) 0);\n+        buffer.putInt(1 << 30);\n+        buffer.putInt(1);\n+        buffer.put((byte) 't');\n+        buffer.putInt(0);\n+        buffer.flip();\n+\n+        assertThrows(IllegalArgumentException.class, () -> PositionSerde.deserialize(buffer));\n+    }\n+\n+    @Test\n+    public void shouldRejectNegativeTopicCount() {\n+        final ByteBuffer buffer = ByteBuffer.allocate(1 + 4);\n+        buffer.put((byte) 0);\n+        buffer.putInt(-1);\n+        buffer.flip();\n+\n+        assertThrows(IllegalArgumentException.class, () -> PositionSerde.deserialize(buffer));\n+    }\n+\n+    @Test\n+    public void shouldRejectPartitionCountLargerThanRemainingBuffer() {\n+        final ByteBuffer buffer = ByteBuffer.allocate(1 + 4 + 4 + 1 + 4 + 4 + 8);\n+        buffer.put((byte) 0);\n+        buffer.putInt(1);\n+        buffer.putInt(1);\n+        buffer.put((byte) 't');\n+        buffer.putInt(1 << 30);\n+        buffer.putInt(0);\n+        buffer.putLong(0L);\n+        buffer.flip();\n+\n+        assertThrows(IllegalArgumentException.class, () -> PositionSerde.deserialize(buffer));\n+    }\n+\n+    @Test\n+    public void shouldRejectNegativePartitionCount() {\n+        final ByteBuffer buffer = ByteBuffer.allocate(1 + 4 + 4 + 1 + 4);\n+        buffer.put((byte) 0);\n+        buffer.putInt(1);\n+        buffer.putInt(1);\n+        buffer.put((byte) 't');\n+        buffer.putInt(-1);\n+        buffer.flip();\n+\n+        assertThrows(IllegalArgumentException.class, () -> PositionSerde.deserialize(buffer));\n+    }\n+}"
  }
