{"pull": {"id": "number:23871", "number": 23871, "title": "MINOR: Use a SmallIntegerSet to copy the group spec for assignor offload", "state": "closed", "draft": false, "created_at": "2026-10-19T17:55:46Z", "closed_at": "2026-10-20T15:21:51Z", "merged_at": null, "user": {"login": "squah-confluent", "id": 163298686, "node_id": "U_kgDOCbu9fg", "avatar_url": "https://avatars.githubusercontent.com/u/163298686?v=4", "gravatar_id": "", "url": "https://api.github.com/users/squah-confluent", "html_url": "https://github.com/squah-confluent", "followers_url": "https://api.github.com/users/squah-confluent/followers", "following_url": "https://api.github.com/users/squah-confluent/following{/other_user}", "gists_url": "https://api.github.com/users/squah-confluent/gists{/gist_id}", "starred_url": "https://api.github.com/users/squah-confluent/starred{/owner}{/repo}", "subscriptions_url": "https://api.github.com/users/squah-confluent/subscriptions", "organizations_url": "https://api.github.com/users/squah-confluent/orgs", "repos_url": "https://api.github.com/users/squah-confluent/repos", "events_url": "https://api.github.com/users/squah-confluent/events{/privacy}", "received_events_url": "https://api.github.com/users/squah-confluent/received_events", "type": "User", "user_view_type": "public", "site_admin": false}, "body": "Add SmallIntegerSet, an immutable BitSet-backed set of small integers,\nand use it to copy the assigned and assignable partitions into the group\nspec when the assignor is offloaded. GroupSpecImpl now holds the\nassigned partitions of each topic instead of the inverted target\nassignment, since assignors never read the owner of a partition.\n\nThis makes buildGroupSpecWithOffload 23-55% faster in\nTargetAssignmentBuilderBenchmark with 5000 and 10000 members.\n\nCo-Authored-By: Claude Opus 5.5 <noreply@anthropic.com>\n", "labels": [{"id": 970614414, "node_id": "MDU6TGFiZWw5NzA2MTQ0MTQ=", "url": "https://api.github.com/repos/apache/kafka/labels/performance", "name": "performance", "color": "c2e0c6", "default": false, "description": "", "archived_at": null, "archived_by": null}, {"id": 7865607612, "node_id": "LA_kwDOACG9q88AAAAB1NOlvA", "url": "https://api.github.com/repos/apache/kafka/labels/triage", "name": "triage", "color": "006b75", "default": false, "description": "PRs from the community", "archived_at": null, "archived_by": null}, {"id": 8846059803, "node_id": "LA_kwDOACG9q88AAAACD0QpGw", "url": "https://api.github.com/repos/apache/kafka/labels/group-coordinator", "name": "group-coordinator", "color": "9AFD22", "default": false, "description": "", "archived_at": null, "archived_by": null}], "html_url": "https://github.com/apache/kafka/pull/23871"}, "reviews": [], "review_comments": [], "issue_comments": [], "commits": [], "files": [], "timeline": [], "_partial": "search", "_source": "extra-data/github-search/author_squah-confluent_is_pr.json"}