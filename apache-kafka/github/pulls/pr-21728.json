{"pull": {"id": "number:21728", "number": 21728, "title": "KAFKA-20292 [1/N]: Handle membership changes during offloaded assignments", "state": "closed", "draft": false, "created_at": "2026-03-12T06:54:46Z", "closed_at": "2026-06-05T14:48:20Z", "merged_at": null, "user": {"login": "squah-confluent", "id": 163298686, "node_id": "U_kgDOCbu9fg", "avatar_url": "https://avatars.githubusercontent.com/u/163298686?v=4", "gravatar_id": "", "url": "https://api.github.com/users/squah-confluent", "html_url": "https://github.com/squah-confluent", "followers_url": "https://api.github.com/users/squah-confluent/followers", "following_url": "https://api.github.com/users/squah-confluent/following{/other_user}", "gists_url": "https://api.github.com/users/squah-confluent/gists{/gist_id}", "starred_url": "https://api.github.com/users/squah-confluent/starred{/owner}{/repo}", "subscriptions_url": "https://api.github.com/users/squah-confluent/subscriptions", "organizations_url": "https://api.github.com/users/squah-confluent/orgs", "repos_url": "https://api.github.com/users/squah-confluent/repos", "events_url": "https://api.github.com/users/squah-confluent/events{/privacy}", "received_events_url": "https://api.github.com/users/squah-confluent/received_events", "type": "User", "user_view_type": "public", "site_admin": false}, "body": "When a member leaves a group, its target assignment is directly removed.\nWhen a static member is replaced, its target assignment is moved to the\nnew member. These target assignment updates can happen while an\noffloaded assignment is being computed.\n\nWhen an offloaded assignment has finished, we must not emit records for\nmembers that have left the group and we must apply any static member\nreplacements that occurred to the emitted records, to match the\nbehavior when assignments are not offloaded. That is, we act as if the\nmember removals and static member replacements are reordered after the\nassignment.\n\nWe break up the assignment process into two parts: computing the target\nassignment map and generating the records. Only the former can run on\nthe executor. To generate the records without removed members and with\nstatic member replacements applied we need to use the current state of\nthe group.", "labels": [{"id": 970614414, "node_id": "MDU6TGFiZWw5NzA2MTQ0MTQ=", "url": "https://api.github.com/repos/apache/kafka/labels/performance", "name": "performance", "color": "c2e0c6", "default": false, "description": "", "archived_at": null, "archived_by": null}, {"id": 7865607612, "node_id": "LA_kwDOACG9q88AAAAB1NOlvA", "url": "https://api.github.com/repos/apache/kafka/labels/triage", "name": "triage", "color": "006b75", "default": false, "description": "PRs from the community", "archived_at": null, "archived_by": null}, {"id": 7865613726, "node_id": "LA_kwDOACG9q88AAAAB1NO9ng", "url": "https://api.github.com/repos/apache/kafka/labels/needs-attention", "name": "needs-attention", "color": "FBCA04", "default": false, "description": "", "archived_at": null, "archived_by": null}, {"id": 8846059803, "node_id": "LA_kwDOACG9q88AAAACD0QpGw", "url": "https://api.github.com/repos/apache/kafka/labels/group-coordinator", "name": "group-coordinator", "color": "9AFD22", "default": false, "description": "", "archived_at": null, "archived_by": null}], "html_url": "https://github.com/apache/kafka/pull/21728"}, "reviews": [], "review_comments": [], "issue_comments": [], "commits": [], "files": [], "timeline": [], "_partial": "search", "_source": "extra-data/github-search/author_squah-confluent_is_pr.json"}