{"pull": {"id": "number:18737", "number": 18737, "title": "KAFKA-18641: AsyncKafkaConsumer could lose records with auto offset commit", "state": "closed", "draft": false, "created_at": "2025-01-29T07:17:40Z", "closed_at": "2025-02-20T17:11:02Z", "merged_at": "2025-02-20T17:11:02Z", "user": {"login": "frankvicky", "id": 51072200, "node_id": "MDQ6VXNlcjUxMDcyMjAw", "avatar_url": "https://avatars.githubusercontent.com/u/51072200?v=4", "gravatar_id": "", "url": "https://api.github.com/users/frankvicky", "html_url": "https://github.com/frankvicky", "followers_url": "https://api.github.com/users/frankvicky/followers", "following_url": "https://api.github.com/users/frankvicky/following{/other_user}", "gists_url": "https://api.github.com/users/frankvicky/gists{/gist_id}", "starred_url": "https://api.github.com/users/frankvicky/starred{/owner}{/repo}", "subscriptions_url": "https://api.github.com/users/frankvicky/subscriptions", "organizations_url": "https://api.github.com/users/frankvicky/orgs", "repos_url": "https://api.github.com/users/frankvicky/repos", "events_url": "https://api.github.com/users/frankvicky/events{/privacy}", "received_events_url": "https://api.github.com/users/frankvicky/received_events", "type": "User", "user_view_type": "public", "site_admin": false}, "body": "JIRA: KAFKA-18641\r\nPlease refer to jira ticket for further details.\r\nThe application thread advances positions, but `SubscriptionState#allConsumed()` is called by a background thread. In the current architecture, there is no way to sync the offsets between two threads, which leads to inconsistency between committed offsets and actually consumed records.\r\n\r\nThis patch implements a waiting mechanism to ensure the background thread has generated commit requests before allowing the application thread to start a new poll cycle and fetch new messages.\r\n\r\n### Committer Checklist (excluded from commit message)\r\n- [ ] Verify design and implementation \r\n- [ ] Verify test coverage and CI build status\r\n- [ ] Verify documentation (including upgrade notes)\r\n", "labels": [{"id": 851033232, "node_id": "MDU6TGFiZWw4NTEwMzMyMzI=", "url": "https://api.github.com/repos/apache/kafka/labels/consumer", "name": "consumer", "color": "bf6a03", "default": false, "description": "", "archived_at": null, "archived_by": null}, {"id": 4771354362, "node_id": "LA_kwDOACG9q88AAAABHGUW-g", "url": "https://api.github.com/repos/apache/kafka/labels/KIP-848", "name": "KIP-848", "color": "0E87F1", "default": false, "description": "The Next Generation of the Consumer Rebalance Protocol", "archived_at": null, "archived_by": null}, {"id": 5536940330, "node_id": "LA_kwDOACG9q88AAAABSgcBKg", "url": "https://api.github.com/repos/apache/kafka/labels/ctr", "name": "ctr", "color": "554CC1", "default": false, "description": "Consumer Threading Refactor (KIP-848)", "archived_at": null, "archived_by": null}, {"id": 7119021596, "node_id": "LA_kwDOACG9q88AAAABqFOmHA", "url": "https://api.github.com/repos/apache/kafka/labels/Blocker", "name": "Blocker", "color": "b60205", "default": false, "description": "This pull request is identified as solving a blocker for a release.", "archived_at": null, "archived_by": null}, {"id": 7491388177, "node_id": "LA_kwDOACG9q88AAAABvoWDEQ", "url": "https://api.github.com/repos/apache/kafka/labels/clients", "name": "clients", "color": "ededed", "default": false, "description": null, "archived_at": null, "archived_by": null}, {"id": 7522931565, "node_id": "LA_kwDOACG9q88AAAABwGbTbQ", "url": "https://api.github.com/repos/apache/kafka/labels/ci-approved", "name": "ci-approved", "color": "ffffff", "default": false, "description": "", "archived_at": null, "archived_by": null}], "html_url": "https://github.com/apache/kafka/pull/18737"}, "reviews": [], "review_comments": [], "issue_comments": [], "commits": [], "files": [], "timeline": [], "_partial": "search", "_source": "extra-data/github-search/author_frankvicky_is_pr.json"}