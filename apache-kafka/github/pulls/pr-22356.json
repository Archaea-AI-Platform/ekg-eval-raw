{"pull": {"id": "number:22356", "number": 22356, "title": "KAFKA-20601: Allow static member rejoin when consumer group is full.", "state": "closed", "draft": false, "created_at": "2026-05-23T14:56:11Z", "closed_at": "2026-06-23T07:06:00Z", "merged_at": "2026-06-23T07:06:00Z", "user": {"login": "chickenchickenlove", "id": 90125071, "node_id": "MDQ6VXNlcjkwMTI1MDcx", "avatar_url": "https://avatars.githubusercontent.com/u/90125071?v=4", "gravatar_id": "", "url": "https://api.github.com/users/chickenchickenlove", "html_url": "https://github.com/chickenchickenlove", "followers_url": "https://api.github.com/users/chickenchickenlove/followers", "following_url": "https://api.github.com/users/chickenchickenlove/following{/other_user}", "gists_url": "https://api.github.com/users/chickenchickenlove/gists{/gist_id}", "starred_url": "https://api.github.com/users/chickenchickenlove/starred{/owner}{/repo}", "subscriptions_url": "https://api.github.com/users/chickenchickenlove/subscriptions", "organizations_url": "https://api.github.com/users/chickenchickenlove/orgs", "repos_url": "https://api.github.com/users/chickenchickenlove/repos", "events_url": "https://api.github.com/users/chickenchickenlove/events{/privacy}", "received_events_url": "https://api.github.com/users/chickenchickenlove/received_events", "type": "User", "user_view_type": "public", "site_admin": false}, "body": "Previously, a static member rejoining a full modern consumer group could\nbe rejected by the max group size check before the coordinator resolved\nthat it was replacing an existing static member.\n\nNow, the max size check allows existing static members by `instanceId`\nto proceed to the static member validation/replacement path. New members\nare still rejected when the consumer group is at capacity, and\nunreleased static instance IDs still fail with the appropriate\nexception.\n\nReviewers: nileshkumar3 <nileshkumar3@gmail.com>, David Jacot\n <david.jacot@gmail.com>\n", "labels": [{"id": 7522931565, "node_id": "LA_kwDOACG9q88AAAABwGbTbQ", "url": "https://api.github.com/repos/apache/kafka/labels/ci-approved", "name": "ci-approved", "color": "ffffff", "default": false, "description": "", "archived_at": null, "archived_by": null}, {"id": 8846059803, "node_id": "LA_kwDOACG9q88AAAACD0QpGw", "url": "https://api.github.com/repos/apache/kafka/labels/group-coordinator", "name": "group-coordinator", "color": "9AFD22", "default": false, "description": "", "archived_at": null, "archived_by": null}], "html_url": "https://github.com/apache/kafka/pull/22356"}, "reviews": [], "review_comments": [], "issue_comments": [], "commits": [], "files": [], "timeline": [], "_partial": "search", "_source": "extra-data/github-search/Cherry-pick_is_pr.json"}