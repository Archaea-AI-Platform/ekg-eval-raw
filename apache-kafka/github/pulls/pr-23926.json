  "title": "KAFKA-9998: Bound the I/O thread join in KafkaProducer.close(timeout)",
  "user": {
   "login": "ARV0007",
   "id": 142774891,
   "node_id": "U_kgDOCIKSaw",
   "avatar_url": "https://avatars.githubusercontent.com/u/142774891?v=4",
   "gravatar_id": "",
   "url": "https://api.github.com/users/ARV0007",
   "html_url": "https://github.com/ARV0007",
   "followers_url": "https://api.github.com/users/ARV0007/followers",
   "following_url": "https://api.github.com/users/ARV0007/following{/other_user}",
   "gists_url": "https://api.github.com/users/ARV0007/gists{/gist_id}",
   "starred_url": "https://api.github.com/users/ARV0007/starred{/owner}{/repo}",
   "subscriptions_url": "https://api.github.com/users/ARV0007/subscriptions",
   "organizations_url": "https://api.github.com/users/ARV0007/orgs",
   "repos_url": "https://api.github.com/users/ARV0007/repos",
   "events_url": "https://api.github.com/users/ARV0007/events{/privacy}",
   "received_events_url": "https://api.github.com/users/ARV0007/received_events",
   "type": "User",
