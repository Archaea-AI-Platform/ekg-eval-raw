   "sha": "c1b50a1902197e2f1750e4410506db46fa20697b",
   "filename": "streams/src/test/java/org/apache/kafka/streams/processor/internals/ChangelogRecordDeserializationHelperTest.java",
   "status": "added",
   "additions": 119,
