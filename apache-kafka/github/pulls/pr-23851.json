   "filename": "group-coordinator/src/main/java/org/apache/kafka/coordinator/group/GroupMetadataManager.java",
   "status": "modified",
   "additions": 12,
   "deletions": 5,
   "changes": 17,
   "blob_url": "https://github.com/apache/kafka/blob/e21a003e2b3ae34432fda00e7785421233241425/group-coordinator%2Fsrc%2Fmain%2Fjava%2Forg%2Fapache%2Fkafka%2Fcoordinator%2Fgroup%2FGroupMetadataManager.java",
   "raw_url": "https://github.com/apache/kafka/raw/e21a003e2b3ae34432fda00e7785421233241425/group-coordinator%2Fsrc%2Fmain%2Fjava%2Forg%2Fapache%2Fkafka%2Fcoordinator%2Fgroup%2FGroupMetadataManager.java",
   "contents_url": "https://api.github.com/repos/apache/kafka/contents/group-coordinator%2Fsrc%2Fmain%2Fjava%2Forg%2Fapache%2Fkafka%2Fcoordinator%2Fgroup%2FGroupMetadataManager.java?ref=e21a003e2b3ae34432fda00e7785421233241425",
   "patch": "@@ -4616,11 +4616,18 @@ private UpdateTargetAssignmentResult<Map<String, TasksTuple>> maybeUpdateStreams\n             time.milliseconds()\n         );\n         if (!canComputeNextTargetAssignment) {\n-            returnedStatus.ifPresent(statusList -> statusList.add(\n-                new Status()\n-                    .setStatusCode(StreamsGroupHeartbeatResponse.Status.ASSIGNMENT_DELAYED.code())\n-                    .setStatusDetail(\"Assignment delayed due to the configured assignment interval.\")\n-            ));\n+            Map<String, TasksTuple> existingAssignment = updatedMembersAndTargetAssignment.targetAssignment();\n+            boolean hasTargetAssignment = updatedMember\n+                .map(member -> existingAssignment.containsKey(member.memberId()))\n+                .orElse(false);\n+\n+            if (!hasTargetAssignment) {\n+                returnedStatus.ifPresent(statusList -> statusList.add(\n+                    new Status()\n+                        .setStatusCode(StreamsGroupHeartbeatResponse.Status.ASSIGNMENT_DELAYED.code())\n+                        .setStatusDetail(\"Assignment delayed due to the configured assignment interval.\")\n+                ));    \n+            }\n \n             return new UpdateTargetAssignmentResult<>(group.assignmentEpoch(), updatedMembersAndTargetAssignment.targetAssignment());\n         }"
  },
  {
   "sha": "e6aeb985dd22eb1e1fe9fbd216f09200d2b57d9c",
   "filename": "group-coordinator/src/test/java/org/apache/kafka/coordinator/group/GroupMetadataManagerTest.java",
   "status": "modified",
   "additions": 31,
   "deletions": 0,
   "changes": 31,
   "blob_url": "https://github.com/apache/kafka/blob/e21a003e2b3ae34432fda00e7785421233241425/group-coordinator%2Fsrc%2Ftest%2Fjava%2Forg%2Fapache%2Fkafka%2Fcoordinator%2Fgroup%2FGroupMetadataManagerTest.java",
   "raw_url": "https://github.com/apache/kafka/raw/e21a003e2b3ae34432fda00e7785421233241425/group-coordinator%2Fsrc%2Ftest%2Fjava%2Forg%2Fapache%2Fkafka%2Fcoordinator%2Fgroup%2FGroupMetadataManagerTest.java",
   "contents_url": "https://api.github.com/repos/apache/kafka/contents/group-coordinator%2Fsrc%2Ftest%2Fjava%2Forg%2Fapache%2Fkafka%2Fcoordinator%2Fgroup%2FGroupMetadataManagerTest.java?ref=e21a003e2b3ae34432fda00e7785421233241425",
   "patch": "@@ -31713,6 +31713,37 @@ fooTopicName, computeTopicHash(fooTopicName, metadataImage)\n             result2.records()\n         );\n \n+        // Joining the group does not imply that the member has a target assignment yet.\n+        CoordinatorResult<StreamsGroupHeartbeatResult, CoordinatorRecord> pendingResult = context.streamsGroupHeartbeat(\n+            new StreamsGroupHeartbeatRequestData()\n+                .setGroupId(groupId)\n+                .setMemberId(memberId2)\n+                .setMemberEpoch(2));\n+\n+        assertEquals(result2.response().data().status(), pendingResult.response().data().status());\n+        assertEquals(2, pendingResult.response().data().memberEpoch());\n+        assertRecordsEquals(List.of(), pendingResult.records());\n+\n+        // An existing assignment remains ready while the next assignment is delayed.\n+        CoordinatorResult<StreamsGroupHeartbeatResult, CoordinatorRecord> retainedResult = context.streamsGroupHeartbeat(\n+            new StreamsGroupHeartbeatRequestData()\n+                .setGroupId(groupId)\n+                .setMemberId(memberId1)\n+                .setMemberEpoch(2));\n+\n+        assertResponseEquals(\n+            new StreamsGroupHeartbeatResponseData()\n+                .setMemberId(memberId1)\n+                .setMemberEpoch(2)\n+                .setHeartbeatIntervalMs(5000)\n+                .setStatus(List.of())\n+                .setTaskOffsetIntervalMs(60_000)\n+                .setAcceptableRecoveryLag(10_000L),\n+            retainedResult.response().data()\n+        );\n+        assertRecordsEquals(List.of(), retainedResult.records());\n+        assertEquals(expectedMember1, context.groupMetadataManager.streamsGroup(groupId).getMemberOrThrow(memberId1));\n+\n         // Wait a little more. The next target assignment can be computed now.\n         context.time.sleep(10);\n "
  }
 ],
