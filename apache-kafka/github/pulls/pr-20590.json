{"pull": {"id": "number:20590", "number": 20590, "title": "KAFKA-19732, KAFKA-19716: Clear out coordinator snapshots periodically while loading", "state": "closed", "draft": false, "created_at": "2025-09-25T11:45:51Z", "closed_at": "2025-09-26T09:01:05Z", "merged_at": "2025-09-26T09:01:05Z", "user": {"login": "squah-confluent", "id": 163298686, "node_id": "U_kgDOCbu9fg", "avatar_url": "https://avatars.githubusercontent.com/u/163298686?v=4", "gravatar_id": "", "url": "https://api.github.com/users/squah-confluent", "html_url": "https://github.com/squah-confluent", "followers_url": "https://api.github.com/users/squah-confluent/followers", "following_url": "https://api.github.com/users/squah-confluent/following{/other_user}", "gists_url": "https://api.github.com/users/squah-confluent/gists{/gist_id}", "starred_url": "https://api.github.com/users/squah-confluent/starred{/owner}{/repo}", "subscriptions_url": "https://api.github.com/users/squah-confluent/subscriptions", "organizations_url": "https://api.github.com/users/squah-confluent/orgs", "repos_url": "https://api.github.com/users/squah-confluent/repos", "events_url": "https://api.github.com/users/squah-confluent/events{/privacy}", "received_events_url": "https://api.github.com/users/squah-confluent/received_events", "type": "User", "user_view_type": "public", "site_admin": false}, "body": "When nested Timeline collections are created and discarded while loading\na coordinator partition, references to them accumulate in the current\nsnapshot. Allow the GC to reclaim them by starting a new snapshot and\ndiscarding previous snapshots every 16,384 records.\n    \nSmall intervals degrade loading times for non-transactional offset\ncommit workloads while large intervals degrade loading times for\ntransactional workloads. A default of 16,384 was chosen as a compromise.\n    \nCherry pick of d067c6c04089a3d24e1f72e6cb1b10b0d85f76da.\n\nReviewers: David Jacot <djacot@confluent.io>\n", "labels": [{"id": 7522931565, "node_id": "LA_kwDOACG9q88AAAABwGbTbQ", "url": "https://api.github.com/repos/apache/kafka/labels/ci-approved", "name": "ci-approved", "color": "ffffff", "default": false, "description": "", "archived_at": null, "archived_by": null}], "html_url": "https://github.com/apache/kafka/pull/20590"}, "reviews": [], "review_comments": [], "issue_comments": [], "commits": [], "files": [], "timeline": [], "_partial": "search", "_source": "extra-data/github-search/author_squah-confluent_is_pr.json"}