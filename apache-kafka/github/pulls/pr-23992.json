  "title": "KAFKA-20752: Respect logical schema when formatting dates",
  "user": {
   "login": "vnayakg",
   "id": 58037628,
   "node_id": "MDQ6VXNlcjU4MDM3NjI4",
   "avatar_url": "https://avatars.githubusercontent.com/u/58037628?v=4",
   "gravatar_id": "",
   "url": "https://api.github.com/users/vnayakg",
   "html_url": "https://github.com/vnayakg",
   "followers_url": "https://api.github.com/users/vnayakg/followers",
