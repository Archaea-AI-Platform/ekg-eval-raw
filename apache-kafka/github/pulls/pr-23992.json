   "subscriptions_url": "https://api.github.com/users/vnayakg/subscriptions",
   "organizations_url": "https://api.github.com/users/vnayakg/orgs",
   "repos_url": "https://api.github.com/users/vnayakg/repos",
   "events_url": "https://api.github.com/users/vnayakg/events{/privacy}",
