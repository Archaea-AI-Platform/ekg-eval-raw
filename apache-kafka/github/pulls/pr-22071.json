{"pull": {"id": "number:22071", "number": 22071, "title": "KAFKA-20455: Wait for all producers to send startup_complete before executing system test", "state": "closed", "draft": false, "created_at": "2026-04-15T21:40:30Z", "closed_at": "2026-10-14T13:58:47Z", "merged_at": null, "user": {"login": "kirktrue", "id": 92057, "node_id": "MDQ6VXNlcjkyMDU3", "avatar_url": "https://avatars.githubusercontent.com/u/92057?v=4", "gravatar_id": "", "url": "https://api.github.com/users/kirktrue", "html_url": "https://github.com/kirktrue", "followers_url": "https://api.github.com/users/kirktrue/followers", "following_url": "https://api.github.com/users/kirktrue/following{/other_user}", "gists_url": "https://api.github.com/users/kirktrue/gists{/gist_id}", "starred_url": "https://api.github.com/users/kirktrue/starred{/owner}{/repo}", "subscriptions_url": "https://api.github.com/users/kirktrue/subscriptions", "organizations_url": "https://api.github.com/users/kirktrue/orgs", "repos_url": "https://api.github.com/users/kirktrue/repos", "events_url": "https://api.github.com/users/kirktrue/events{/privacy}", "received_events_url": "https://api.github.com/users/kirktrue/received_events", "type": "User", "user_view_type": "public", "site_admin": false}, "body": "Track producer startup events and block until all producers have\nstarted. Adds a start() override that waits (for a  configurable\ntimeout) until all of the producers configured for the test have sent\nthe startup_complete event. This ensures tests don't proceed until\nproducers have finished initialization.\n\nReviewers: ChickenchickenLove <ojt90902@naver.com>, Lianet Magrans\n <lmagrans@confluent.io>\n", "labels": [{"id": 1257747426, "node_id": "MDU6TGFiZWwxMjU3NzQ3NDI2", "url": "https://api.github.com/repos/apache/kafka/labels/tests", "name": "tests", "color": "cfff60", "default": false, "description": "Test fixes (including flaky tests)", "archived_at": null, "archived_by": null}, {"id": 5604089486, "node_id": "LA_kwDOACG9q88A