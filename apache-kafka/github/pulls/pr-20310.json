{"pull": {"id": "number:20310", "number": 20310, "title": "KAFKA-19476: Correcting max delivery on write state failure and lock timeout", "state": "closed", "draft": false, "created_at": "2025-08-05T16:42:24Z", "closed_at": "2025-08-07T18:22:01Z", "merged_at": "2025-08-07T18:22:01Z", "user": {"login": "apoorvmittal10", "id": 2861565, "node_id": "MDQ6VXNlcjI4NjE1NjU=", "avatar_url": "https://avatars.githubusercontent.com/u/2861565?v=4", "gravatar_id": "", "url": "https://api.github.com/users/apoorvmittal10", "html_url": "https://github.com/apoorvmittal10", "followers_url": "https://api.github.com/users/apoorvmittal10/followers", "following_url": "https://api.github.com/users/apoorvmittal10/following{/other_user}", "gists_url": "https://api.github.com/users/apoorvmittal10/gists{/gist_id}", "starred_url": "https://api.github.com/users/apoorvmittal10/starred{/owner}{/repo}", "subscriptions_url": "https://api.github.com/users/apoorvmittal10/subscriptions", "organizations_url": "https://api.github.com/users/apoorvmittal10/orgs", "repos_url": "https://api.github.com/users/apoorvmittal10/repos", "events_url": "https://api.github.com/users/apoorvmittal10/events{/privacy}", "received_events_url": "https://api.github.com/users/apoorvmittal10/received_events", "type": "User", "user_view_type": "public", "site_admin": false}, "body": "Fixing max delivery check on acquisition lock timeout and write state\nRPC failure.\n\nWhen acquisition lock is already timed out and write state RPC failure\noccurs then we need to check if records need to be archived. However\nwith the fix we do not persist the information, which is relevant as\nsome records may be  archived or delivery count is bumped. The\ninformation will be persisted eventually.\n\nThe persister call has failed already hence issuing another persister\ncall due to a failed persister call earlier is not correct. Rather let\nthe data persist in future persister calls.\n\nReviewers: Manikumar Reddy <manikumar.reddy@gmail.com>, Abhinav Dixit\n <adixit@confluent.io>\n", "labels": [{"id": 838330122, "node_id": "MDU6TGFiZWw4MzgzMzAxMjI=", "url": "https://api.github.com/repos/apache/kafka/labels/core", "name": "core", "color": "ed5a86", "default": false, "description": "Kafka Broker", "archived_at": null, "archived_by": null}, {"id": 6979675393, "node_id": "LA_kwDOACG9q88AAAABoAVlAQ", "url": "https://api.github.com/repos/apache/kafka/labels/KIP-932", "name": "KIP-932", "color": "DA462F", "default": false, "description": "Queues for Kafka", "archived_at": null, "archived_by": null}, {"id": 7522931565, "node_id": "LA_kwDOACG9q88AAAABwGbTbQ", "url": "https://api.github.com/repos/apache/kafka/labels/ci-approved", "name": "ci-approved", "color": "ffffff", "default": false, "description": "", "archived_at": null, "archived_by": null}], "html_url": "https://github.com/apache/kafka/pull/20310"}, "reviews": [], "review_comments": [], "issue_comments": [], "commits": [], "files": [], "timeline": [], "_partial": "search", "_source": "extra-data/github-search/author_apoorvmittal10_is_pr.json"}