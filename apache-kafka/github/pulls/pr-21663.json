{"pull": {"id": "number:21663", "number": 21663, "title": "KAFKA-20273: Rebalance on classic group downgrade with stale assignment", "state": "closed", "draft": false, "created_at": "2026-03-07T05:08:52Z", "closed_at": "2026-03-09T14:43:22Z", "merged_at": "2026-03-09T14:43:22Z", "user": {"login": "squah-confluent", "id": 163298686, "node_id": "U_kgDOCbu9fg", "avatar_url": "https://avatars.githubusercontent.com/u/163298686?v=4", "gravatar_id": "", "url": "https://api.github.com/users/squah-confluent", "html_url": "https://github.com/squah-confluent", "followers_url": "https://api.github.com/users/squah-confluent/followers", "following_url": "https://api.github.com/users/squah-confluent/following{/other_user}", "gists_url": "https://api.github.com/users/squah-confluent/gists{/gist_id}", "starred_url": "https://api.github.com/users/squah-confluent/starred{/owner}{/repo}", "subscriptions_url": "https://api.github.com/users/squah-confluent/subscriptions", "organizations_url": "https://api.github.com/users/squah-confluent/orgs", "repos_url": "https://api.github.com/users/squah-confluent/repos", "events_url": "https://api.github.com/users/squah-confluent/events{/privacy}", "received_events_url": "https://api.github.com/users/squah-confluent/received_events", "type": "User", "user_view_type": "public", "site_admin": false}, "body": "When assignment batching or offload are enabled, the target assignment\ncan lag behind member subscriptions. When downgrading a consumer group\nto a classic group, we must check if the target assignment is stale and\nenter the PREPARING_REBALANCE state if needed. Downgrades triggered by a\nmember leaving the group already trigger a rebalance, so there is no\nchange on that path.\n\nReviewers: David Jacot <djacot@confluent.io>\n", "labels": [{"id": 7522931565, "node_id": "LA_kwDOACG9q88AAAABwGbTbQ", "url": "https://api.github.com/repos/apache/kafka/labels/ci-approved", "name": "ci-approved", "color": "ffffff", "default": false, "description": "",