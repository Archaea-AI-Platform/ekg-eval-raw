{"pull": {"id": "number:23702", "number": 23702, "title": "MINOR: Fix BackgroundConsumerSet.start() returning before all consumers have joined", "state": "closed", "draft": false, "created_at": "2026-10-04T21:32:59Z", "closed_at": "2026-10-08T06:51:12Z", "merged_at": "2026-10-08T06:51:11Z", "user": {"login": "squah-confluent", "id": 163298686, "node_id": "U_kgDOCbu9fg", "avatar_url": "https://avatars.githubusercontent.com/u/163298686?v=4", "gravatar_id": "", "url": "https://api.github.com/users/squah-confluent", "html_url": "https://github.com/squah-confluent", "followers_url": "https://api.github.com/users/squah-confluent/followers", "following_url": "https://api.github.com/users/squah-confluent/following{/other_user}", "gists_url": "https://api.github.com/users/squah-confluent/gists{/gist_id}", "starred_url": "https://api.github.com/users/squah-confluent/starred{/owner}{/repo}", "subscriptions_url": "https://api.github.com/users/squah-confluent/subscriptions", "organizations_url": "https://api.github.com/users/squah-confluent/orgs", "repos_url": "https://api.github.com/users/squah-confluent/repos", "events_url": "https://api.github.com/users/squah-confluent/events{/privacy}", "received_events_url": "https://api.github.com/users/squah-confluent/received_events", "type": "User", "user_view_type": "public", "site_admin": false}, "body": "BackgroundConsumerSet.start() waits on a latch sized to the number of\nconsumers, but each consumer thread counted the latch down on every poll\nwith a non-empty assignment. One consumer could release the latch before\nthe others had joined. Count down once per consumer instead.\n\nAlso signal readiness from the first onPartitionsAssigned callback\ninstead of polling for a non-empty assignment, so that a consumer\nwithout partitions does not block start(). testDescribeGroups asserts on\nmember assignments, so it now waits for the group to become STABLE after\nstart() returns.\n\nCo-Authored-By: Claude Opus 5.5 <noreply@anthropic.com>\n\nReviewers: Chia-Ping Tsai <chia7712@gmail.com>\n", "labels": [{"id": 838330122, "node_id": "MDU6TGFiZWw4MzgzMzAxMjI=", "url": "https://api.github.com/repos/apache/kafka/labels/core", "name": "core", "color": "ed5a86", "default": false, "description": "Kafka Broker", "archived_at": null, "archived_by": null}, {"id": 1257747426, "node_id": "MDU6TGFiZWwxMjU3NzQ3NDI2", "url": "https://api.github.com/repos/apache/kafka/labels/tests", "name": "tests", "color": "cfff60", "default": false, "description": "Test fixes (including flaky tests)", "archived_at": null, "archived_by": null}, {"id": 7559660738, "node_id": "LA_kwDOACG9q88AAAABwpdEwg", "url": "https://api.github.com/repos/apache/kafka/labels/small", "name": "small", "color": "FEF2C0", "default": false, "description": "Small PRs", "archived_at": null, "archived_by": null}], "html_url": "https://github.com/apache/kafka/pull/23702"}, "reviews": [], "review_comments": [], "issue_comments": [], "commits": [], "files": [], "timeline": [], "_partial": "search", "_source": "extra-data/github-search/author_squah-confluent_is_pr.json"}