{"pull": {"id": "number:20781", "number": 20781, "title": "KAFKA-19449: Don't consider partitions unreleased when pending revocation by the current member", "state": "closed", "draft": false, "created_at": "2025-10-27T23:16:16Z", "closed_at": "2025-11-15T10:50:02Z", "merged_at": "2025-11-15T10:50:02Z", "user": {"login": "squah-confluent", "id": 163298686, "node_id": "U_kgDOCbu9fg", "avatar_url": "https://avatars.githubusercontent.com/u/163298686?v=4", "gravatar_id": "", "url": "https://api.github.com/users/squah-confluent", "html_url": "https://github.com/squah-confluent", "followers_url": "https://api.github.com/users/squah-confluent/followers", "following_url": "https://api.github.com/users/squah-confluent/following{/other_user}", "gists_url": "https://api.github.com/users/squah-confluent/gists{/gist_id}", "starred_url": "https://api.github.com/users/squah-confluent/starred{/owner}{/repo}", "subscriptions_url": "https://api.github.com/users/squah-confluent/subscriptions", "organizations_url": "https://api.github.com/users/squah-confluent/orgs", "repos_url": "https://api.github.com/users/squah-confluent/repos", "events_url": "https://api.github.com/users/squah-confluent/events{/privacy}", "received_events_url": "https://api.github.com/users/squah-confluent/received_events", "type": "User", "user_view_type": "public", "site_admin": false}, "body": "During reconciliation, we transition members to UNRELEASED_PARTITIONS\nwhen the target assignment contains a partition that is owned by another\nmember. Partitions are considered owned by another member if they are in\na member's assignment or partitions pending revocation. Ownership is\nonly updated after reconciliation has finished.\n\nFix a bug where we consider a partition owned by another member when it\nis actually in the current member's list of partitions pending\nrevocation. In some cases, this skips a transition to\nUNRELEASED_PARTITIONS and allows the current assignment to converge to\nthe target assignment one heartbeat sooner.\n\nReviewers: PoAn Yang <payang@apache.org>, David Jacot\n <djacot@confluent.io>\n", "labels": [{"id": 7522931565, "node_id": "LA_kwDOACG9q88AAAABwGbTbQ", "url": "https://api.github.com/repos/apache/kafka/labels/ci-approved", "name": "ci-approved", "color": "ffffff", "default": false, "description": "", "archived_at": null, "archived_by": null}, {"id": 7559660738, "node_id": "LA_kwDOACG9q88AAAABwpdEwg", "url": "https://api.github.com/repos/apache/kafka/labels/small", "name": "small", "color": "FEF2C0", "default": false, "description": "Small PRs", "archived_at": null, "archived_by": null}, {"id": 8846059803, "node_id": "LA_kwDOACG9q88AAAACD0QpGw", "url": "https://api.github.com/repos/apache/kafka/labels/group-coordinator", "name": "group-coordinator", "color": "9AFD22", "default": false, "description": "", "archived_at": null, "archived_by": null}], "html_url": "https://github.com/apache/kafka/pull/20781"}, "reviews": [], "review_comments": [], "issue_comments": [], "commits": [], "files": [], "timeline": [], "_partial": "search", "_source": "extra-data/github-search/author_squah-confluent_is_pr.json"}