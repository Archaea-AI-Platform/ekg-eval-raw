{"pull": {"id": "number:20780", "number": 20780, "title": "KAFKA-19826: Implement coordinator adaptive batch linger time", "state": "closed", "draft": false, "created_at": "2025-10-27T22:00:53Z", "closed_at": "2025-11-14T20:16:28Z", "merged_at": "2025-11-14T20:16:28Z", "user": {"login": "squah-confluent", "id": 163298686, "node_id": "U_kgDOCbu9fg", "avatar_url": "https://avatars.githubusercontent.com/u/163298686?v=4", "gravatar_id": "", "url": "https://api.github.com/users/squah-confluent", "html_url": "https://github.com/squah-confluent", "followers_url": "https://api.github.com/users/squah-confluent/followers", "following_url": "https://api.github.com/users/squah-confluent/following{/other_user}", "gists_url": "https://api.github.com/users/squah-confluent/gists{/gist_id}", "starred_url": "https://api.github.com/users/squah-confluent/starred{/owner}{/repo}", "subscriptions_url": "https://api.github.com/users/squah-confluent/subscriptions", "organizations_url": "https://api.github.com/users/squah-confluent/orgs", "repos_url": "https://api.github.com/users/squah-confluent/repos", "events_url": "https://api.github.com/users/squah-confluent/events{/privacy}", "received_events_url": "https://api.github.com/users/squah-confluent/received_events", "type": "User", "user_view_type": "public", "site_admin": false}, "body": "Add support for an adaptive batch linger time in the group and share\ncoordinators. When an adaptive batch linger time is enabled, we no\nlonger create a timer to flush the current batch. Instead, we append a\nflush operation at the end of the event queue so that any currently\nqueued operations are naturally collected into the batch.\n\nTo avoid double flushing from hitting the maximum batch size or\ntransactional writes, we number batches with an epoch to check whether\nthe batch has already been flushed.\n\nThe group.coordinator.append.linger.ms and\nshare.coordinator.append.linger.ms configs are extended to allow -1, to\nspecify an adaptive append linger time. The default for these configs is\nalso updated to -1.\n\nReviewers: PoAn Yang <payang@apache.org>, TaiJuWu <tjwu1217@gmail.com>,\n David Jacot <djacot@confluent.io>\n", "labels": [{"id": 838330122, "node_id": "MDU6TGFiZWw4MzgzMzAxMjI=", "url": "https://api.github.com/repos/apache/kafka/labels/core", "name": "core", "color": "ed5a86", "default": false, "description": "Kafka Broker", "archived_at": null, "archived_by": null}, {"id": 6979675393, "node_id": "LA_kwDOACG9q88AAAABoAVlAQ", "url": "https://api.github.com/repos/apache/kafka/labels/KIP-932", "name": "KIP-932", "color": "DA462F", "default": false, "description": "Queues for Kafka", "archived_at": null, "archived_by": null}, {"id": 7522931565, "node_id": "LA_kwDOACG9q88AAAABwGbTbQ", "url": "https://api.github.com/repos/apache/kafka/labels/ci-approved", "name": "ci-approved", "color": "ffffff", "default": false, "description": "", "archived_at": null, "archived_by": null}, {"id": 8846059803, "node_id": "LA_kwDOACG9q88AAAACD0QpGw", "url": "https://api.github.com/repos/apache/kafka/labels/group-coordinator", "name": "group-coordinator", "color": "9AFD22", "default": false, "description": "", "archived_at": null, "archived_by": null}], "html_url": "https://github.com/apache/kafka/pull/20780"}, "reviews": [], "review_comments": [], "issue_comments": [], "commits": [], "files": [], "timeline": [], "_partial": "search", "_source": "extra-data/github-search/author_squah-confluent_is_pr.json"}