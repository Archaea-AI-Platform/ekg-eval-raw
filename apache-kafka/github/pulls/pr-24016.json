  "locked": false,
  "title": "KAFKA-10876: Do not mark a task as FAILED when it is started twice",
  "user": {
   "login": "psiby",
   "id": 253247973,
   "node_id": "U_kgDODxhB5Q",
   "avatar_url": "https://avatars.githubusercontent.com/u/253247973?v=4",
   "gravatar_id": "",
   "url": "https://api.github.com/users/psiby",
   "html_url": "https://github.com/psiby",
   "followers_url": "https://api.github.com/users/psiby/followers",
   "following_url": "https://api.github.com/users/psiby/following{/other_user}",
   "gists_url": "https://api.github.com/users/psiby/gists{/gist_id}",
   "starred_url": "https://api.github.com/users/psiby/starred{/owner}{/repo}",
   "subscriptions_url": "https://api.github.com/users/psiby/subscriptions",
   "organizations_url": "https://api.github.com/users/psiby/orgs",
   "repos_url": "https://api.github.com/users/psiby/repos",
   "events_url": "https://api.github.com/users/psiby/events{/privacy}",
