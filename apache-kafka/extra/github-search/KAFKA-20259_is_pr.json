thub.com/repos/apache/kafka/labels/tests", "name": "tests", "color": "cfff60", "default": false, "description": "Test fixes (including flaky tests)", "archived_at": null, "archived_by": null}, {"id": 7865607612, "node_id": "LA_kwDOACG9q88AAAAB1NOlvA", "url": "https://api.github.com/repos/apache/kafka/labels/triage", "name": "triage", "color": "006b75", "default": false, "description": "PRs from the community", "archived_at": null, "archived_by": null}, {"id": 7865613726, "node_id": "LA_kwDOACG9q88AAAAB1NO9ng", "url": "https://api.github.com/repos/apache/kafka/labels/needs-attention", "name": "needs-attention", "color": "FBCA04", "default": false, "description": "", "archived_at": null, "archived_by": null}], "state": "open", "locked": false, "assignees": [], "milestone": null, "comments": 1, "created_at": "2026-10-19T12:55:47Z", "updated_at": "2026-10-29T03:15:57Z", "closed_at": null, "assignee": null, "author_association": "CONTRIBUTOR", "issue_field_values": [], "type": null, "active_lock_reason": null, "draft": false, "pull_request": {"url": "https://api.github.com/repos/apache/kafka/pulls/23864", "html_url": "https://github.com/apache/kafka/pull/23864", "diff_url": "https://github.com/apache/kafka/pull/23864.diff", "patch_url": "https://github.com/apache/kafka/pull/23864.patch", "merged_at": null}, "body": "Add integration tests to `QueryableStateIntegrationTest` that verify IQv1 works with the headers-aware state stores of KIP-1271 and KIP-1285.\n\n- DSL stores, created with the `Stores.*WithHeaders` suppliers or with `dsl.store.format=HEADERS`: point, range, prefix, reverse, window, and session queries through the headers-aware, timestamped, and plain query types, including multiple, overlapping, and merged windows and sessions, global tables, record updates, and tombstones. DSL operators write empty headers to their stores (see the KIP-1285 current limitations), so the input records carry headers and the tests assert that the queried headers are empty.\n- Processor API stores that store the record headers: the queried headers match the produced ones (no header, a single header, multiple headers in insertion order, and repeated header keys), with and without caching, on the active and the standby host, after a rebalance, after a restart that reopens the local stores, and during and after restoration from the changelog.\n\nThis continues #21906 by @Shekharrajak, which cannot be updated anymore.\n\n\ud83e\udd16 Generated with [Claude Code](https://claude.com/claude-code)\n\nCo-authored-by: Shekhar Rajak <shekharrajak@live.com>\n", "reactions": {"url": "https://api.github.com/repos/apache/kafka/issues/23864/reactions", "total_count": 0, "+1": 0, "-1": 0, "laugh": 0, "hooray": 0, "confused": 0, "heart": 0, "rocket": 0, "eyes": 0}, "timeline_url": "https://api.github.com/repos/apache/kafka/issues/23864/timeline", "performed_via_github_app": null, "state_reason": null, "score": 1.0}, {"url": "https://api.github.com/repos/apache/kafka/issues/21906", "repository_url": "https://api.github.com/repos/apache/kafka", "labels_url": "https://api.github.com/repos/apache/kafka/issues/21906/labels{/name}", "comments_url": "https://api.github.com/repos/apache/kafka/issues/21906/comments", "events_url": "https://api.github.com/repos/apache/kafka/issues/21906/events", "html_url": "https://github.com/apache/kafka/pull/21906", "id": 4177552031, "node_id": "PR_kwDOACG9q87O44Yy", "number": 21906, "title": "KAFKA-20259: Verify IQv1 and IQv2 do not break with headers-aware state stores", "user": {"login": "Shekharrajak", "id": 5774448, "node_id": "MDQ6VXNlcjU3NzQ0NDg=", "avatar_url": "https://avatars.githubusercontent.com/u/5774448?v=4", "gravatar_id": "", "url": "https://api.github.com/users/Shekharrajak", "html_url": "https://github.com/Shekharrajak", "followers_url": "https://api.github.com/users/Shekharrajak/followers", "following_url": "https://api.github.com/users/Shekharrajak/following{/other_user}", "gists_url": "https://api.github.com/use