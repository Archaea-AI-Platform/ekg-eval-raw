r", "user_view_type": "public", "site_admin": false}, "labels": [], "state": "closed", "locked": false, "assignees": [], "milestone": null, "comments": 1, "created_at": "2020-02-12T18:36:18Z", "updated_at": "2024-03-25T15:23:28Z", "closed_at": "2020-06-19T06:40:00Z", "assignee": null, "author_association": "MEMBER", "issue_field_values": [], "type": null, "active_lock_reason": null, "draft": false, "pull_request": {"url": "https://api.github.com/repos/apache/kafka/pulls/8098", "html_url": "https://github.com/apache/kafka/pull/8098", "diff_url": "https://github.com/apache/kafka/pull/8098.diff", "patch_url": "https://github.com/apache/kafka/pull/8098.patch", "merged_at": null}, "body": "the input data in testThrottledProducerConsumer are 1000 messages and each message carries only a string bytes which is converted from int value. The quota is 8000 bytes/second so it fails to start the throttle if the machine is too slow to complete all request. It is a timer-based test case. The workaround is to increase the size of input data.\r\n\r\n### Committer Checklist (excluded from commit message)\r\n- [ ] Verify design and implementation \r\n- [ ] Verify test coverage and CI build status\r\n- [ ] Verify documentation (including upgrade notes)\r\n", "reactions": {"url": "https://api.github.com/repos/apache/kafka/issues/8098/reactions", "total_count": 0, "+1": 0, "-1": 0, "laugh": 0, "hooray": 0, "confused": 0, "heart": 0, "rocket": 0, "eyes": 0}, "timeline_url": "https://api.github.com/repos/apache/kafka/issues/8098/timeline", "performed_via_github_app": null, "state_reason": null, "score": 1.0}, {"url": "https://api.github.com/repos/apache/kafka/issues/4162", "repository_url": "https://api.github.com/repos/apache/kafka", "labels_url": "https://api.github.com/repos/apache/kafka/issues/4162/labels{/name}", "comments_url": "https://api.github.com/repos/apache/kafka/issues/4162/comments", "events_url": "https://api.github.com/repos/apache/kafka/issues/4162/events", "html_url": "h