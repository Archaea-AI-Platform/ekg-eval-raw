/api.github.com/repos/apache/kafka/labels/tests", "name": "tests", "color": "cfff60", "default": false, "description": "Test fixes (including flaky tests)", "archived_at": null, "archived_by": null}, {"id": 7522931565, "node_id": "LA_kwDOACG9q88AAAABwGbTbQ", "url": "https://api.github.com/repos/apache/kafka/labels/ci-approved", "name": "ci-approved", "color": "ffffff", "default": false, "description": "", "archived_at": null, "archived_by": null}, {"id": 7559660738, "node_id": "LA_kwDOACG9q88AAAABwpdEwg", "url": "https://api.github.com/repos/apache/kafka/labels/small", "name": "small", "color": "FEF2C0", "default": false, "description": "Small PRs", "archived_at": null, "archived_by": null}, {"id": 7865607612, "node_id": "LA_kwDOACG9q88AAAAB1NOlvA", "url": "https://api.github.com/repos/apache/kafka/labels/triage", "name": "triage", "color": "006b75", "default": false, "description": "PRs from the community", "archived_at": null, "archived_by": null}, {"id": 7865613726, "node_id": "LA_kwDOACG9q88AAAAB1NO9ng", "url": "https://api.github.com/repos/apache/kafka/labels/needs-attention", "name": "needs-attention", "color": "FBCA04", "default": false, "description": "", "archived_at": null, "archived_by": null}], "state": "open", "locked": false, "assignees": [], "milestone": null, "comments": 9, "created_at": "2026-05-21T03:39:32Z", "updated_at": "2026-10-30T03:16:13Z", "closed_at": null, "assignee": null, "author_association": "CONTRIBUTOR", "issue_field_values": [], "type": null, "active_lock_reason": null, "draft": false, "pull_request": {"url": "https://api.github.com/repos/apache/kafka/pulls/22338", "html_url": "https://github.com/apache/kafka/pull/22338", "diff_url": "https://github.com/apache/kafka/pull/22338.diff", "patch_url": "https://github.com/apache/kafka/pull/22338.patch", "merged_at": null}, "body": "Ref: https://issues.apache.org/jira/browse/KAFKA-8073\r\n\r\n## Causes\r\n1. `produceUntilThrottled` sent tiny payloads, so on slow hosts the\r\n   1000 sends could stay under the 8000 B/s producer quota and never\r\n   trigger a throttle.\r\n2. The broker `throttle-time` metric was cached once before the send\r\n   loop, so the lazily-registered sensor could be missed.\r\n3. `verifyThrottleTimeRequestChannelMetric` asserted on the broker\r\n   `ThrottleTimeMs` histogram immediately, before the broker had\r\n   recorded the value.\r\n\r\n## Changes\r\n- Use a fixed 2 KB payload in `produceUntilThrottled` so the quota is\r\n  reliably exceeded.\r\n- Re-read the broker throttle-time metric inside the send loop.\r\n- Poll the RequestChannel `ThrottleTimeMs` via `TestUtils.waitUntilTrue`.\r\n", "reactions": {"url": "https://api.github.com/repos/apache/kafka/issues/22338/reactions", "total_count": 0, "+1": 0, "-1": 0, "laugh": 0, "hooray": 0, "confused": 0, "heart": 0, "rocket": 0, "eyes": 0}, "timeline_url": "https://api.github.com/repos/apache/kafka/issues/22338/timeline", "performed_via_github_app": null, "state_reason": null, "score": 1.0}, {"url": "https://api.github.com/repos/apache/kafka/issues/18558", "repository_url": "https://api.github.com/repos/apache/kafka", "labels_url": "https://api.github.com/repos/apache/kafka/issues/18558/labels{/name}", "comments_url": "https://api.github.com/repos/apache/kafka/issues/18558/comments", "events_url": "https://api.github.com/repos/apache/kafka/issues/18558/events", "html_url": "https://github.com/apache/kafka/pull/18558", "id": 2790179437, "node_id": "PR_kwDOACG9q86H3mbP", "number": 18558, "title": "MINOR: Added flaky references for a few tests.", "user": {"login": "smjn", "id": 787991, "node_id": "MDQ6VXNlcjc4Nzk5MQ==", "avatar_url": "https://avatars.githubusercontent.com/u/787991?v=4", "gravatar_id": "", "url": "https://api.github.com/users/smjn", "html_url": "https://github.com/smjn", "followers_url": "https://api.github.com/users/smjn/followers", "following_url": "https://api.github.com/users/smjn/following{/other_user}", "gists_url": "https://api.github.com/users/smjn/gists{/gist_id}", "starred_url": "https://api.github.com/users/smjn/starred{/owner}{/repo}", "subscriptions_url": "https://api.github.com/users/smjn/subscriptions", "organizations_url": "https://api.github.com/users/smjn/orgs", "repos_url": "https://api.github.com/users/smjn/repos", "events_url": "https://api.github.com/users/smjn/events{/privacy}", "received_events_url": "https://api.github.com/users/smjn/received_events", "type": "User", "user_view_type": "public", "site_admin": false}, "labels": [{"id": 838330122, "node_id": "MDU6TGFiZWw4MzgzMzAxMjI=", "url": "https://api.github.com/repos/apache/kafka/labels/core", "name": "core", "color": "ed5a86", "default": false, "description": "Kafka Broker", "archived_at": null, "archived_by": null}, {"id": 851033232, "node_id": "MDU6TGFiZWw4NTEwMzMyMzI=", "url": "https://api.github.com/repos/apache/kafka/labels/consumer", "name": "consumer", "color": "bf6a03", "default": false, "description": "", "archived_at": null, "archived_by": null}, {"id": 1257747426, "node_id": "MDU6TGFiZWwxMjU3NzQ3NDI2", "url": "https://api.github.com/repos/apache/kafka/labels/tests", "name": "tests", "color": "cfff60", "default": false, "description": "Test fixes (including flaky tests)", "archived_at": null, "archived_by": null}, {"id": 7491388177, "node_id": "LA_kwDOACG9q88AAAABvoWDEQ", "url": "https://api.github.com/repos/apache/kafka/labels/clients", "name": "clients", "color": "ededed", "default": false, "description": null, "archived_at": null, "archived_by": null}, {"id": 7522931565, "node_id": "LA_kwDOACG9q88AAAABwGbTbQ", "url": "https://api.github.com/repos/apache/kafka/labels/ci-approved", "name": "ci-approved", "color": "ffffff", "default": false, "description": "", "archived_at": null, "archived_by": null}, {"id": 7559660738, "node_id": "LA_kwDOACG9q88AAAABwpdEwg", "url": "https://api.github.com/repos/apache/kafka/labels/small", "name": "small", "color": "FEF2C0", "default": false, "description": "Small PRs", "archived_at": null, "archived_by": null}], "state": "closed", "locked": false, "assignees": [], "milestone": null, "comments": 0, "created_at": "2025-01-15T15:38:15Z", "updated_at": "2025-01-15T19:24:52Z", "closed_at": "2025-01-15T19:24:52Z", "assignee": null, "author_association": "CONTRIBUTOR", "issue_field_values": [], "type": null, "active_lock_reason": null, "draft": false, "pull_request": {"url": "https://api.github.com/repos/apache/kafka/pulls/18558", "html_url": "https://github.com/apache/kafka/pull/18558", "diff_url": "https://github.com/apache/kafka/pull/18558.diff", "patch_url": "https://github.com/apache/kafka/pull/18558.patch", "merged_at": "2025-01-15T19:24:52Z"}, "body": "Following tests were found to be flaky over multiple runs on local and confirmed by develocity (details in the jiras)\r\n\r\nKafkaAdminClientTest > testAdminClientApisAuthenticationFailure() - https://issues.apache.org/jira/browse/KAFKA-18441\r\nEagerConsumerCoordinatorTest > testOutdatedCoordinatorAssignment() - https://issues.apache.org/jira/browse/KAFKA-15900\r\nUserQuotaTest > testThrottledProducerConsumer(String, String).quorum=kraft.groupProtocol=classic - https://issues.apache.org/jira/browse/KAFKA-8073\r\n\r\n*Note:* Some tests are in `clients` module which does not have any other project dependencies. The flaky annotation is part of `test-common` and hence they are not explicitly marked `@Flaky`. Instead I've added comments to create breadcrumb trail without disrupting the code. \r\n\r\nThe exact test for `UserQuotaTest` is in its superclass so not possible to add the annotation. \r\n", "reactions": {"url": "https://api.github.com/repos/apache/kafka/issues/18558/reactions", "total_count": 0, "+1": 0, "-1": 0, "laugh": 0, "hooray": 0, "confused": 0, "heart": 0, "rocket": 0, "eyes": 0}, "timeline_url": "https://api.github.com/repos/apache/kafka/issues/18558/timeline", "performed_via_github_app": null, "state_reason": null, "score": 1.0}, {"url": "https://api.github.com/repos/apache/kafka/issues/18453", "r