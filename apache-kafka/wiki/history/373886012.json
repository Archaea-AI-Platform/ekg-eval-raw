   "title": "KIP-1192: Add include argument to ConsumerPerformance tool",
   "version": {
    "by": {
     "type": "known",
     "username": "fvaleri",
     "userKey": "ae84fb5e7da6acf7017f74e432920596",
     "profilePicture": {
      "path": "/confluence/images/icons/profilepics/default.svg",
