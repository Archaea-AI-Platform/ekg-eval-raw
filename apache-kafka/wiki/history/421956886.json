   "id": "421956886",
   "type": "page",
   "status": "historical",
   "title": "KIP-1322: Add metrics to Kraft that measure the number of fetch timeouts and election timeouts",
   "version": {
    "by": {
     "type": "known",
     "username": "tzyyzt2025",
     "userKey": "073590d29897aadc0198afc04a6e0005",
     "profilePicture": {
      "path": "/confluence/images/icons/profilepics/default.svg",
      "width": 48,
      "height": 48,
      "isDefault": true
     },
     "displayName": "tony tang",
     "_links": {
      "self": "https://cwiki.apache.org/confluence/rest/api/user?key=073590d29897aadc0198afc04a6e0005"
     },
     "_expandable": {
      "status": ""
     }
    },
    "when": "2026-05-26T16:25:16.000Z",
    "message": "",
    "number": 16,
    "minorEdit": false,
    "hidden": false,
    "_links": {
     "self": "https://cwiki.apache.org/confluence/rest/experimental/content/421956886/version/16"
