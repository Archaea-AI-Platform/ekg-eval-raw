CommitAppend(producerId, topicIdPartition, CommitRecordMetadataAndOffset(So=
me(status.baseOffset), offsetAndMetadata))
> =C2=A0 =C2=A0 =C2=A0 =C2=A0 =C2=A0 =C2=A0 =C2=A0 else
> =C2=A0 =C2=A0 =C2=A0 =C2=A0 =C2=A0 =C2=A0 =C2=A0 =C2=A0 group.onOffsetCom=
mitAppend(topicIdPartition, CommitRecordMetadataAndOffset(Some(status.baseO=
ffset), offsetAndMetadata))
> =C2=A0 =C2=A0 =C2=A0 =C2=A0 =C2=A0 =C2=A0 }
> =C2=A0 =C2=A0 =C2=A0 =C2=A0 =C2=A0 }
> =C2=A0 =C2=A0 =C2=A0 =C2=A0 =C2=A0 // Record the number of offsets commit=
ted to the log
> =C2=A0 =C2=A0 =C2=A0 =C2=A0 =C2=A0 offsetCommitsSensor.record(records.siz=
e)
> =C2=A0 =C2=A0 =C2=A0 =C2=A0 =C2=A0 Errors.NONE
> =C2=A0 =C2=A0 =C2=A0 =C2=A0 } else {
