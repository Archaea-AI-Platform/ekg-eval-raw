7254fac/core/src/main/scala/kafka/server/DynamicBrokerConfig.scala#L120]
[1] [https://github.com/apache/kafka/blob/trunk/core/src/main/scala/kafka/s=
erver/DynamicConfig.scala#L35]
[2] [https://github.com/apache/kafka/blob/trunk/core/src/main/scala/kafka/s=
erver/DynamicConfig.scala#L36]
[3] [https://github.com/apache/kafka/blob/638844f833b165d6f9ca52c173858d26b=
7254fac/core/src/main/scala/kafka/server/DynamicBrokerConfig.scala#L120]



