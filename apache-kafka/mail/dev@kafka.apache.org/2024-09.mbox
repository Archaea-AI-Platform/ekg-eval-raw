>
> When consumer subscribes an invalid topic name like " this is test", clas=
sic consumer can unsubscribe without error. However, async consumer can't. =
We can use following integration test to validate:
> =C2=A0
> {code:java}
> @ParameterizedTest(name =3D TestInfoUtils.TestWithParameterizedQuorumAndG=
roupProtocolNames)
> @MethodSource(Array("getTestQuorumAndGroupProtocolParametersAll"))
> def testSubscribeInvalidTopic(quorum: String, groupProtocol: String): Uni=
t =3D {
>   // Invalid topic name due to space
>   val invalidTopicName =3D "topic abc"
>   val consumer =3D createConsumer()
>   consumer.subscribe(List(invalidTopicName).asJava)
>   var exception : InvalidTopicException =3D null
>   TestUtils.waitUntilTrue(() =3D> {
>     try consumer.poll(Duration.ofMillis(500)) catch {
>       case e : InvalidTopicException =3D> exception =3D e
>       case e : Throwable =3D> fail(s"An InvalidTopicException should be t=
hrown. But ${e.getClass} is thrown")
>     }
>     exception !=3D null
>   }, waitTimeMs =3D 5000, msg =3D "An InvalidTopicException should be thr=
own.")
>   assertEquals(s"Invalid topics: [${invalidTopicName}]", exception.getMes=
sage)
>   // AsyncKafkaConsumer sends request in background thread. Wait enough t=
ime to send next request.
>   Thread.sleep(1000)
>   assertDoesNotThrow(new Executable {
>     override def execute(): Unit =3D consumer.unsubscribe()
>   })
> }{code}



