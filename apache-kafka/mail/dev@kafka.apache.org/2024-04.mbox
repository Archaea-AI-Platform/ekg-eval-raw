=09at org.apache.kafka.image.loader.MetadataLoader.lambda$scheduleInitializ=
eNewPublishers$0(MetadataLoader.java:266)
=09at org.apache.kafka.queue.KafkaEventQueue$EventContext.run(KafkaEventQue=
ue.java:127)
