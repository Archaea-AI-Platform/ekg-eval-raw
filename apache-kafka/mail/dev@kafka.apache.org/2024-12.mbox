dater(TaskManager.java:1010)\n\tat org.apache.kafka.streams.processor.inter=
nals.TaskManager.addTasksToStateUpdater(TaskManager.java:997)\n\tat org.apa=
che.kafka.streams.processor.internals.TaskManager.checkStateUpdater(TaskMan=
ager.java:911)\n\tat org.apache.kafka.streams.processor.internals.StreamThr=
ead.checkStateUpdater(StreamThread.java:1188)\n\tat org.apache.kafka.stream=
