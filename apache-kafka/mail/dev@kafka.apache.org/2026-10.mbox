long coldSnapshottedPartitionsCount =3D shareStateMap.values().stream()
=C2=A0 =C2=A0 =C2=A0 =C2=A0 =C2=A0 =C2=A0 .filter(shareGroupOffset -> share=
GroupOffset.createTimestamp() - shareGroupOffset.writeTimestamp() !=3D 0)
=C2=A0 =C2=A0 =C2=A0 =C2=A0 =C2=A0 =C2=A0 .count();

=C2=A0 =C2=A0 =C2=A0 =C2=A0 // If all share partitions are snapshotted, it =
means that
=C2=A0 =C2=A0 =C2=A0 =C2=A0 // system is quiet and cold snapshotting will n=
ot help much.
=C2=A0 =C2=A0 =C2=A0 =C2=A0 if (coldSnapshottedPartitionsCount =3D=3D share=
StateMap.size()) {
