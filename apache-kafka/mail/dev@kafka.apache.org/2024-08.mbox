         Attachments: image-2024-08-28-14-42-44-152.png

When writing data, the starting position and the last offset of the current=
 fetch data will be written to the index. However, when dumping the index, =
the starting position and the last offset of a batch are verified. Therefor=
e, if the follower fetches multiple batches, it will cause problems with th=
e index file.

=C2=A0

Reproduction=EF=BC=9A

Unit test in DumpLogSegmentsTest

=C2=A0
{code:java}
def addMultiRecordBatches(): Unit =3D {
  var recordsCount =3D 0L
  val batches =3D new ArrayBuffer[BatchInfo]
  val now =3D System.currentTimeMillis()
  val firstBatchRecords =3D (0 until 10).map { i =3D> new SimpleRecord(now =
+ i * 2, s"message key $i".getBytes, s"message value $i".getBytes)}
  batches +=3D BatchInfo(firstBatchRecords, true, true)
  val secondBatchRecords =3D (10 until 30).map { i =3D> new SimpleRecord(no=
w + i * 3, s"message key $i".getBytes, null)}
  batches +=3D BatchInfo(secondBatchRecords, true, false)
  val thirdBatchRecords =3D (30 until 50).map { i =3D> new SimpleRecord(now=
 + i * 5, null, s"message value $i".getBytes)}
  batches +=3D BatchInfo(thirdBatchRecords, false, true)
  val fourthBatchRecords =3D (50 until 60).map { i =3D> new SimpleRecord(no=
w + i * 7, null)}
  batches +=3D BatchInfo(fourthBatchRecords, false, false)

  batches.foreach { batchInfo =3D>
    val buf =3D ByteBuffer.allocate(2048)
    batchInfo.records.grouped(5).foreach { records =3D>
      val builder =3D MemoryRecords.builder(buf, RecordBatch.MAGIC_VALUE_V1=
, Compression.NONE, TimestampType.CREATE_TIME, recordsCount)
      records.foreach(builder.append)
      builder.close()
      recordsCount +=3D records.size.toLong
    }
    buf.flip()
    log.appendAsFollower(MemoryRecords.readableRecords(buf.slice()))
  }
  // Flush, but don't close so that the indexes are not trimmed and contain=
 some zero entries
  log.flush(false)
}

