":0,"data":{"partitionId":7,"topicId":"Pd7wMb4lSkKI00--SrWNXw","isr":[3,1,8=
]}}
| offset: 38656256 CreateTime: 1683849994297 keySize: -1 valueSize: 39 sequ=
