sk.batchDispatched(ExactlyOnceWorkerSourceTask.java:186)
=C2=A0 =C2=A0 at org.apache.kafka.connect.runtime.AbstractWorkerSourceTask.=
execute(AbstractWorkerSourceTask.java:362)
=C2=A0 =C2=A0 at org.apache.kafka.connect.runtime.WorkerTask.doRun(WorkerTa=
sk.java:202)
=C2=A0 =C2=A0 at org.apache.kafka.connect.runtime.WorkerTask.run(WorkerTask=
.java:257)
=C2=A0 =C2=A0 at org.apache.kafka.connect.runtime.AbstractWorkerSourceTask.=
run(AbstractWorkerSourceTask.java:75)
=C2=A0 =C2=A0 at org.apache.kafka.connect.runtime.isolation.Plugins.lambda$=
withClassLoader$1(Plugins.java:181)
=C2=A0 =C2=A0 at java.base/java.util.concurrent.Executors$RunnableAdapter.c=
all(Executors.java:515)
=C2=A0 =C2=A0 at java.base/java.util.concurrent.FutureTask.run(FutureTask.j=
ava:264)
=C2=A0 =C2=A0 at java.base/java.util.concurrent.ThreadPoolExecutor.runWorke=
r(ThreadPoolExecutor.java:1128)
=C2=A0 =C2=A0 at java.base/java.util.concurrent.ThreadPoolExecutor$Worker.r=
un(ThreadPoolExecutor.java:628)
