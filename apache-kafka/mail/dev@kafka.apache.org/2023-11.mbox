dListener=3Dfalse, principalSerde=3DOptional[REDACTED]) (kafka.server.Kafka=
Apis)
> java.util.concurrent.CompletionException: org.apache.kafka.common.errors.=
UnsupportedVersionException: LeaveGroup response version 1 can only contain=
 one member, got 0 members.
> =09at java.base/java.util.concurrent.CompletableFuture.encodeThrowable(Co=
mpletableFuture.java:315)
> =09at java.base/java.util.concurrent.CompletableFuture.completeThrowable(=
CompletableFuture.java:320)
> =09at java.base/java.util.concurrent.CompletableFuture.uniHandle(Completa=
bleFuture.java:936)
> =09at java.base/java.util.concurrent.CompletableFuture.uniHandleStage(Com=
pletableFuture.java:950)
> =09at java.base/java.util.concurrent.CompletableFuture.handle(Completable=
Future.java:2340)
