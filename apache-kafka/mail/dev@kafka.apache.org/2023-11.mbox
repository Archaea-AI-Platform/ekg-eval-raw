> metricLevel =3D High | Low (default: Low)
> metricNameRegEx =3D regEx (default: .*)
> nameOfDimension =3D string
> dimensionRegEx =3D regEx
> dimensionFilter =3D [<nameOfDimension>=3D<dimensionRegEx>] (default: [])
>
> Final Value schema =3D "level"=3D$metricLevel, "name"=3D$metricNameRegEx,
