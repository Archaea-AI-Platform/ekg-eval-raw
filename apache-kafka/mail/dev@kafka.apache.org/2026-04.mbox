n {
        testCloseWithRemainInGroup(GroupProtocol.CLASSIC);
    }

    @ClusterTest
    public void testAsyncConsumerCloseWithRemainInGroup() throws Exception =
{
        testCloseWithRemainInGroup(GroupProtocol.CONSUMER);
    }

    private void testCloseWithRemainInGroup(GroupProtocol groupProtocol) th=
rows Exception {
        var groupId =3D "group_test";
        Map<String, Object> consumerConfig =3D Map.of(
            GROUP_PROTOCOL_CONFIG, groupProtocol.name().toLowerCase(Locale.=
ROOT),
            KEY_DESERIALIZER_CLASS_CONFIG, ByteArrayDeserializer.class.getN=
ame(),
            VALUE_DESERIALIZER_CLASS_CONFIG, ByteArrayDeserializer.class.ge=
tName(),
            AUTO_OFFSET_RESET_CONFIG, "earliest",
            GROUP_ID_CONFIG, groupId,
            BOOTSTRAP_SERVERS_CONFIG, cluster.bootstrapServers()
        );
        var topicName =3D "close-with-remain-in-group";
        var numRecords =3D 1;
        cluster.createTopic(topicName, 2, (short) 2, Map.of());

        sendRecords(cluster, new TopicPartition(topicName, 0), numRecords);

        String memberId;
        try (Consumer<byte[], byte[]> consumer =3D cluster.consumer(consume=
rConfig)) {
            consumer.subscribe(Set.of(topicName));
            consumeRecords(consumer, numRecords);
            memberId =3D consumer.groupMetadata().memberId();
            consumer.close(CloseOptions.groupMembershipOperation(
                CloseOptions.GroupMembershipOperation.REMAIN_IN_GROUP));
        }

        try (Admin admin =3D cluster.admin()) {
            var members =3D admin.describeConsumerGroups(List.of(groupId))
                .describedGroups()
                .get(groupId)
                .get()
                .members();
            assertTrue(
                members.stream().anyMatch(m -> memberId.equals(m.consumerId=
())),
                "Expected member " + memberId + " to still be in " + groupI=
d
                    + " after close(REMAIN_IN_GROUP), but members were " + =
members);
        }
    }
}
