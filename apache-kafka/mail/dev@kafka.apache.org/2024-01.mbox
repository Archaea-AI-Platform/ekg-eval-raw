estData(groupId=3D'concurrent_consumer', memberId=3D'laIqS789StuhXFpTwjh6hA=
', memberEpoch=3D1, instanceId=3Dnull, rackId=3Dnull, rebalanceTimeoutMs=3D=
300000, subscribedTopicNames=3D[output-topic], serverAssignor=3Dnull, topic=
P =C2=A0 =C2=A0 artitions=3D[TopicPartitions(topicId=3DI5P5lIXvR1Cjc8hfoJg5=
bg, partitions=3D[0])]), handler=3Dorg.apache.kafka.clients.consumer.intern=
als.NetworkClientDelegate$FutureCompletionHandler@918925b, node=3DOptional[=
