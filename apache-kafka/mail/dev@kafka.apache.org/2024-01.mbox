             Summary: Update list group state type filter to include the st=
ates for the new consumer group type
                 Key: KAFKA-16095
                 URL: https://issues.apache.org/jira/browse/KAFKA-16095
             Project: Kafka
          Issue Type: Sub-task
            Reporter: Ritika Reddy


# While using *=E2=80=94list =E2=80=94state* the current accepted values co=
rrespond to the classic group type states. We need to include support for t=
he new group type states.
 # Consumer Group: Should list the state of the group. Accepted Values:=C2=
=A0
 # _UNKNOWN(=E2=80=9Cunknown=E2=80=9D)_
 # {_}EMPTY{_}("empty"),
 # *{_}ASSIGNING{_}("assigning"),*
 # *{_}RECONCILING{_}("reconciling"),*
 # {_}STABLE{_}("stable"),
 # {_}DEAD{_}("dead");


 # Classic Group : Should list the state of the group. Accepted Values:=C2=
=A0
 # {_}UNKNOWN{_}("Unknown"),
 # {_}EMPTY{_}("Empty");
 # *{_}PREPARING_REBALANCE{_}("PreparingRebalance"),*
 # *{_}COMPLETING_REBALANCE{_}("CompletingRebalance"),*
 # {_}STABLE{_}("Stable"),
 # {_}DEAD{_}("Dead")



