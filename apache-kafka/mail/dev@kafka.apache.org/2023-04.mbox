> =C2=A0 =C2=A0 =C2=A0 =C2=A0 "key.converter": "org.apache.kafka.connect.st=
orage.StringConverter",
> =C2=A0 =C2=A0 =C2=A0 =C2=A0 "value.converter": "org.apache.kafka.connect.=
storage.StringConverter",
> =C2=A0 =C2=A0 =C2=A0 =C2=A0 "tasks.max": 1,
> =C2=A0 =C2=A0 =C2=A0 =C2=A0 "connector.class": "io.lenses.connect.secrets=
.test.TestSinkConnector",
> =C2=A0 =C2=A0 =C2=A0 =C2=A0 "test.sink.secret.value": "${vault:rotate-tes=
t/myVaultSecretPath:myVaultSecretKey}",
> =C2=A0 =C2=A0 =C2=A0 =C2=A0 "config.providers": "vault",
> =C2=A0 =C2=A0 =C2=A0 =C2=A0 "config.providers.vault.class": "io.lenses.co=
nnect.secrets.providers.VaultSecretProvider",
> =C2=A0 =C2=A0 =C2=A0 =C2=A0 "config.providers.vault.param.vault.enginever=
sion": 2,
> =C2=A0 =C2=A0 =C2=A0 =C2=A0 "config.providers.vault.param.vault.token": "=
9c08104f-98b7-4bce-ab86-4a6c63897ec4",
> =C2=A0 =C2=A0 =C2=A0 =C2=A0 "config.providers.vault.param.default.ttl": 3=
0000,
> =C2=A0 =C2=A0 =C2=A0 =C2=A0 "config.providers.vault.param.vault.addr": "h=
ttp://vault:8200",
> =C2=A0 =C2=A0 =C2=A0 =C2=A0 "config.providers.vault.param.vault.auth.meth=
od": "token",
