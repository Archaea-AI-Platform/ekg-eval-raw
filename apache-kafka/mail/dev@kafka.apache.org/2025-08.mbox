user_lakehouse=3D"twbSDhryzmIWkQPmREfMZZ0rfKyoI5yy"

  user_user=3D"twbSDhryzmIWkQPmREfMZZ0rfKyoI5yy";

};




bash-5.1$ cat server.properties | tail -n 15

# ------ watsonx.data kafka broker SSL configuration ------

ssl.endpoint.identification.algorithm=3D

ssl.keystore.type=3DPKCS12

ssl.keystore.password=3Dbtqxlns0eEbAw2sew0dAtfm3

