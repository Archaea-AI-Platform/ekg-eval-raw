ntHashMap<>();
private final AtomicLong maxFinalizedFeaturesEpoch =3D new AtomicLong(-1);
private final AtomicReference<Map<String, Short>> finalizedFeatures =3D new=
 AtomicReference<>(new ConcurrentHashMap<>());

public void update(String nodeId, NodeApiVersions nodeApiVersions) {
    this.nodeApiVersions.put(nodeId, nodeApiVersions);
    if (maxFinalizedFeaturesEpoch.get() < nodeApiVersions.finalizedFeatures=
Epoch()) {
        this.maxFinalizedFeaturesEpoch.set(nodeApiVersions.finalizedFeature=
sEpoch());
        this.finalizedFeatures.set(new ConcurrentHashMap<>(nodeApiVersions.=
finalizedFeatures()));
    }
}

public void remove(String nodeId) {
    this.nodeApiVersions.remove(nodeId);
}

public NodeApiVersions get(String nodeId) {
