> > find docs/ -name "*.md" -type f | while read -r file; do
> >      dir=3D$(dirname "$file")
> >      filename=3D$(basename "$file" .md)
> >      mkdir -p "39-ascii/$dir"
> >      pandoc -f markdown -t plain "$file" -o "39-ascii/$dir/$filename.tx=
t"
> > done
