apshot(KRaftMigrationZkWriter.java:115)
> =09at org.apache.kafka.metadata.migration.KRaftMigrationDriver$SyncKRaftM=
etadataEvent.run(KRaftMigrationDriver.java:790)
> =09at org.apache.kafka.queue.KafkaEventQueue$EventContext.run(KafkaEventQ=
ueue.java:127)
