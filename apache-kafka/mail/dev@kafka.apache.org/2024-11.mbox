d7dceb/core/src/main/java/kafka/server/share/SharePartition.java#L1649

[1] https://github.com/apache/kafka/blob/trunk/share/src/main/java/org/apac=
he/kafka/server/share/persister/PersisterStateManager.java#L80

[2] https://github.com/apache/kafka/blob/trunk/core/src/main/java/kafka/ser=
ver/share/SharePartition.java#L665

[3] https://github.com/apache/kafka/blob/trunk/core/src/main/java/kafka/ser=
ver/share/SharePartition.java#L646

[4] https://github.com/apache/kafka/blob/trunk/core/src/main/java/kafka/ser=
ver/share/SharePartition.java#L1663



