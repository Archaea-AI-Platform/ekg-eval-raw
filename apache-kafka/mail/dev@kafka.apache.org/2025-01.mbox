see [https://github.com/apache/kafka/blob/516d5240b98916feb3e51c8a143dede05=
a4edad1/core/src/main/scala/kafka/log/LogCleaner.scala#L127]

=C2=A0

=C2=A0 private def maxOverCleanerThreads(f: CleanerThread =3D> Double): Int=
 =3D
=C2=A0 =C2=A0 cleaners.foldLeft(0.0d)((max: Double, thread: CleanerThread) =
=3D> math.max(max, f(thread))).toInt

=C2=A0 /* a metric to track the maximum utilization of any thread's buffer =
in the last cleaning */
=C2=A0 metricsGroup.newGauge(MaxBufferUtilizationPercentMetricName,
=C2=A0 =C2=A0 () =3D> maxOverCleanerThreads(_.lastStats.bufferUtilization) =
* 100)

we always round down the double value, so `maxOverCleanerThreads(_.lastStat=
s.bufferUtilization)` returns 0 always



